# DR. SparkPlay — Playwright test credentials
# Copy this file to .env.test.local and fill in your values.
# .env.test.local is git-ignored — never commit real credentials.

# Your Director account (a real account in your Supabase project)
TEST_DIRECTOR_EMAIL=director@example.com
TEST_DIRECTOR_PASSWORD=your-password-here

# Base URL for the app under test (defaults to http://localhost:3000)
# Change to your deployed URL to run against prod/staging instead.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
